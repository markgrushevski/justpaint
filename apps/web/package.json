{
    "name": "@justpaint/web",
    "type": "module",
    "private": true,
    "scripts": {
        "types": "vue-tsc",
        "types:watch": "vue-tsc --watch",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint:prettier": "npx prettier --write **/*.{vue,js,ts,css,json,md,html}",
        "lint:stylelint": "npx stylelint --fix **/*.{vue,css}",
        "lint:eslint": "npx eslint --fix **/*.{vue,js,ts}",
        "lint:contrast": "node scripts/check-contrast.mjs",
        "lint:styles": "node scripts/check-styles.mjs",
        "lint:all": "npm run lint:prettier && npm run lint:stylelint && npm run lint:eslint && npm run lint:contrast && npm run lint:styles",
        "lint:ci": "npx stylelint \"**/*.{vue,css}\" && npx eslint \"**/*.{vue,js,ts}\" && npm run lint:contrast && npm run lint:styles",
        "test": "vitest run --dir src",
        "test:a11y": "playwright test tests/a11y",
        "test:layout": "playwright test tests/layout",
        "test:flows": "playwright test tests/flows"
    },
    "dependencies": {
        "@justpaint/editor": "*",
        "@oriui/css": "1.0.0-rc.23",
        "@oriui/headless": "1.0.0-rc.23",
        "@oriui/vue": "1.0.0-rc.23",
        "@tanstack/vue-query": "^5.104.1",
        "@vue/devtools-api": "^8.2.1",
        "colord": "^2.10.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.9",
        "stylelint": "^17.16.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vue-tsc": "^3.3.12"
    }
}
