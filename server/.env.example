# Copy to .env for local dev (never commit .env). The server reads these from the environment.

# Environment — MANDATORY, no default. Decides the Secure flag on the session
# cookie, the JWT_SECRET length floor and the WS origin default. Only "dev" or
# "prod" are accepted; anything else (including unset) is a boot error, so a
# deploy cannot silently fall back to dev-grade cookies.
ENV=dev

# Apply the embedded goose migrations at boot (default true). On, because the
# deploy target has no shell — running a one-off command against the production
# database is a paid feature there. Set false where a pipeline or a human owns
# the schema and the server must never touch it.
# AUTO_MIGRATE=true

# HTTP
ADDR=:8080
LOG_LEVEL=info
# Believe X-Forwarded-For / X-Request-Id? Set true ONLY when the server sits
# behind exactly one trusted proxy that APPENDS to XFF (Render, Fly, an nginx you
# control). False (the default) keys rate limiting on the direct peer: correct
# locally, but behind a proxy it collapses every client into one bucket. True in
# front of an untrusted network lets a client forge the header and dodge limits.
# TRUST_PROXY=false
# Built SPA to serve alongside the API, making them one origin (the session
# cookie and the WS upgrade are same-origin, and no CORS headers are sent).
# Empty in dev — Vite serves the SPA on :7777 and proxies /api here. The Docker
# image sets it to /app/web.
# STATIC_DIR=/abs/path/to/apps/web/dist

# Postgres — MANDATORY. The one datastore (docs/ARCHITECTURE.md §1).
DATABASE_URL=postgres://justpaint:justpaint@localhost:5432/justpaint?sslmode=disable
# Pool ceiling. Keep it under the database's own max_connections budget —
# managed free tiers allow very few. Default 10.
# DB_MAX_CONNS=10

# Auth — MANDATORY. The server fails fast if unset; outside dev it also rejects
# secrets shorter than 32 bytes. Generate one:  openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Judge raster renderer. "stub" (default) is the zero-dep in-process stand-in;
# "node" renders the authoritative raster via the Node worker (needs `node` on
# PATH + `npm run build -w @justpaint/render`, and RENDER_CLI set). The server
# fails fast if RENDER_MODE=node without RENDER_CLI.
RENDER_MODE=stub
# Ceiling on simultaneous judging passes (render + judge), AND — under
# RENDER_MODE=node — on the render worker subprocesses themselves, whoever asked
# for them: /api/guess and /api/practice render inline on the request goroutine,
# so without a bound inside the renderer one burst under the write rate-limit
# tier is thirty node-canvas processes at once. Each is tens of MB resident, so
# this is the memory knob on a small instance. Default 2.
# JUDGE_CONCURRENCY=2
# Daily AI-call budget, over a ROLLING 24h window, enforced per kind whose impl
# really calls a provider -- the impl is asked, not inferred from the mode, so a
# "fake" impl (and today's not-yet-wired assist scaffold) spends no external quota
# and is never counted. One call is one provider request, and a free tier's binding
# limit is requests per DAY -- the per-IP rate limiter bounds the request RATE, not
# this. An allowance set here for a kind that calls nobody is inert and says so at
# boot; an allowance below 1 on a kind that DOES call somebody is a boot error.
#
# AI_DAILY_GLOBAL is the whole service, applied PER PROVIDER AND MODEL: one
# vendor running dry must not refuse a feature backed by another that still has
# quota, and -- since Google meters its free tier per MODEL -- a kind pinned to
# its own model gets its own pool rather than sharing a counter with a different
# one.
# AI_DAILY_PER_USER gives each kind its own player ceiling, so a cheap-but-chatty
# feature cannot be spent at the rate of an expensive one. Kinds not named here
# keep the defaults in internal/aibudget (duel 20, practice 20, guess 2, assist 40).
# Every value must be >= 1: there is no "unlimited" -- set a large number if you
# mean effectively none.
#
# The global default is 15, down from 200 on 2026-09-20, because the API answered
# the question itself in the body of a 429: quotaId
# "GenerateRequestsPerDayPerProjectPerModel-FreeTier", model "gemini-3.6-flash",
# quotaValue "20" -- twenty requests a day, per project, PER MODEL. Read 15
# honestly: on a free key OUR ceiling is not the one that binds (theirs is, and it
# arrives as a 429 the handlers turn into the same calm refusal), and 15 is not
# "safe" either -- the ledger records one row per judging PASS while a pass may
# retry up to 3 times inside the seam, so 15 rows are 15 to 45 real requests.
# What it buys is that one player cannot burn the day's quota in a burst. Raise it
# the moment the key is not a free one.
# AI_DAILY_GLOBAL=15
# AI_DAILY_PER_USER=duel=20,practice=20,guess=2,assist=40
#
# The pre-per-kind names still work, so a deployed environment needs no edit:
# JUDGE_DAILY_BUDGET is an alias of AI_DAILY_GLOBAL (setting both to DIFFERENT
# values is a boot error), and JUDGE_DAILY_PER_USER seeds "duel" and "practice"
# only -- the two kinds that shared it when it was named. It deliberately does not
# reach kinds invented since, so an old 20 never becomes 20 AI guesses a day.
# JUDGE_DAILY_BUDGET=15
# JUDGE_DAILY_PER_USER=20

# Who decides the duel (docs/JUDGE.md). "fake" (default) is the zero-dependency
# ink-coverage stand-in that never reads the prompt -- fine for dev and CI, but
# it is not a judge. "http" calls the ML collaborator's service over the §6
# contract and needs JUDGE_BASE_URL. "gemini" scores both rasters with a vision
# model in ONE call and needs GEMINI_API_KEY. A mode without its dependency is a
# boot error, not a surprise on the first duel.
JUDGE_MODE=fake
# JUDGE_BASE_URL=https://judge.example.com
# Bounds ONE judging call, retries excluded (§7). Default 10s.
# JUDGE_TIMEOUT=10s

# Gemini vision judge. The key is server-side only and never reaches the client;
# it travels in the x-goog-api-key header, never in a URL. Get one from Google AI
# Studio -- the free tier's binding limit is requests per DAY, and one duel costs
# exactly one request. The model id and API root are configurable because
# Google's free-tier names and quotas move faster than our releases: check the
# current ones rather than trusting the default.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# GEMINI_MODEL is the DEFAULT for every AI kind. AI_MODEL_PER_KIND overrides it
# per kind, in the same kind=value comma list AI_DAILY_PER_USER uses, because the
# jobs differ in difficulty: the duel judge compares two drawings and its number
# feeds Elo, so it should be the steadiest; the practice critic scores one drawing
# against a prompt; the guesser only names what it sees and its mistakes cost
# nothing; assist turns a sentence into shapes. Unknown kind names are a boot
# error naming the valid set, and the resolved model per kind is logged at boot.
#
# Note the budget consequence: Google meters per MODEL, so giving a kind its own
# model also gives it its own quota pool ("google:<model>" in the ledger) and its
# own AI_DAILY_GLOBAL ceiling -- more total headroom, and one busy kind can no
# longer empty another's.
# AI_MODEL_PER_KIND=duel=gemini-3.6-pro,guess=gemini-3.6-flash-lite
# RENDER_CLI=/abs/path/to/packages/render/dist/render.mjs
# RENDER_NODE_BIN=node

# AI assist (docs/ASSIST.md) -- the prompt box on /draw.
#
# "fake" (default) returns the SAME canned op batch whatever the user typed: no
# API key, the whole client flow works with zero API dependency, and it is the
# right thing in dev and CI. It is not a feature -- it is a prompt box that
# ignores the prompt -- so do not ship it.
#
# "gemini" is the real one: the prompt becomes shapes. It uses GEMINI_API_KEY and
# GEMINI_BASE_URL, its own ASSIST_TIMEOUT (NOT the judge's -- see below), and the
# model is GEMINI_MODEL unless AI_MODEL_PER_KIND names one for "assist". The
# server fails fast if ASSIST_MODE=gemini without GEMINI_API_KEY. This is
# INDEPENDENT of JUDGE_MODE: a real assist alongside a fake judge is a perfectly
# sensible deployment.
#
# There is no third mode -- an unknown ASSIST_MODE is a boot error naming the
# valid set.
ASSIST_MODE=fake
#
# Bounds ONE assist call, retries excluded. Separate from JUDGE_TIMEOUT because
# the work is not comparable: a verdict is four numbers and lands in a second or
# two, while composing a picture is a list of shapes from a model that reasons
# first (measured 4-9s healthy, far longer when Google is busy). Default 60s.
# ASSIST_TIMEOUT=60s

# WebSocket hardening. The idle timeout evicts a socket with no proof of life;
# the heartbeat probes a quiet one so a player who is simply drawing is never
# mistaken for a dead peer (it MUST be shorter than the timeout, and the client
# pings every 25s). The caps bound concurrent sockets — memory is the scarce
# resource on a small instance. Boot fails on an unlimited cap or a per-IP cap
# above the global one.
# WS_READ_IDLE_TIMEOUT=60s
# WS_HEARTBEAT_INTERVAL=20s
# WS_MAX_CONNS=500
# WS_MAX_CONNS_PER_IP=20

