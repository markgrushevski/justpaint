{
    "name": "justpaint-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "npm run build -w @justpaint/render && cd server && npx dotenv run -- go run ./cmd/server",
        "build": "npm run build --workspaces --if-present",
        "types": "npm run types --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "smoke": "node scripts/smoke.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "dotenv": "^18.0.5",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3"
    }
}
